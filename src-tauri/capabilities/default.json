{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Permisos base de Radar_DJ",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "radar_dj-engine", "sidecar": true, "args": true }
      ]
    },
    "drag:default"
  ]
}
